# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Gemini (Google AI Studio) — used when provider = gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter — used when provider = openrouter. Free models need no credit:
# e.g. dots-studio/dots-3-note-preview:free, or the managed router "openrouter/free".
OPENROUTER_API_KEY=""

# Server-side defaults for every request that carries no per-request AI headers.
# The app's Dev Mode (Settings → Developer Options) sends
# x-ai-key / x-ai-provider / x-ai-model and always wins over these values.
AI_PROVIDER="gemini"          # gemini | openrouter
AI_MODEL=""                   # empty = provider default
                              #   gemini     -> gemini-3.1-pro-preview (flash for short tasks)
                              #   openrouter -> google/gemini-2.0-flash-exp:free
                              #   commandcode -> deepseek/deepseek-v4.1-flash

# CommandCode (subscription provider, OpenAI-compatible). Model IDs carry the org prefix,
# for example deepseek/deepseek-v4.1-flash.
COMMANDCODE_API_KEY=""
COMMANDCODE_BASE_URL="https://api.commandcode.ai/provider/v1"

# Bound one model call. LLM_TIMEOUT_MS caps its duration. LLM_MAX_TOKENS caps the length of the
# answer; when it is empty the call carries no max_tokens and the provider default applies.
# Exception: OpenRouter reserves the full output window (up to 131072 tokens) without a limit and
# rejects the call with HTTP 402 when the key limit is smaller, so it keeps a bounded default.
LLM_TIMEOUT_MS="300000"
LLM_MAX_TOKENS=""

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite file. Relative paths resolve against the process working directory,
# so a container should set an absolute path inside its mounted volume.
DB_PATH="study_quiz.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
